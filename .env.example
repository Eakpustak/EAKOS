# Copy to .env (install.sh does this for you and generates secrets).
DOMAIN=workspace.example.com
POSTGRES_PASSWORD=change-me
NEXTAUTH_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
# Only used to create the first admin when the database has no users.
ADMIN_PASSWORD=

# Private store for restricted employee documents. Inside Docker this is the docdata volume; leave as is.
DOCUMENTS_DIR=/data/documents
