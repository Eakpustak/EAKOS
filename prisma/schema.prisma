generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum MembershipType {
  HEAD
  MEMBER
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  displayName       String
  passwordHash      String?
  /// Set whenever the password changes; any sign-in that began earlier is treated as signed out.
  passwordChangedAt DateTime?
  /// True for a temporary password (new person, admin reset, bootstrap admin) until they choose their own.
  mustChangePassword Boolean              @default(false)
  status            UserStatus             @default(ACTIVE)
  systemRole        SystemRole             @default(MEMBER)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       DepartmentMembership[]
  tasksCreated      Task[]                 @relation("TaskCreator")
  tasksAssigned     Task[]                 @relation("TaskAssignee")
  taskComments      TaskComment[]
  taskEvents        TaskEvent[]
  notifications     Notification[]
  handoversSent     Handover[]             @relation("HandoverSender")
  handoversReceived Handover[]             @relation("HandoverReceiver")
  handoverEvents    HandoverEvent[]
  contentAuthored   ContentItem[]          @relation("ContentAuthor")
  contentPublished  ContentItem[]          @relation("ContentPublisher")
  contentVersions   ContentVersion[]
  leadsOwned        Lead[]                 @relation("LeadOwner")
  leadsCreated      Lead[]                 @relation("LeadCreator")
  leadInteractions  LeadInteraction[]
  projectsOwned     Project[]              @relation("ProjectOwner")
  projectsCreated   Project[]              @relation("ProjectCreator")
  projectMemberships ProjectMember[]       @relation("ProjectMemberUser")
  milestonesDone    Milestone[]            @relation("MilestoneDoneBy")
  leaveRequests     LeaveRequest[]         @relation("LeaveRequester")
  leaveDecided      LeaveRequest[]         @relation("LeaveDecider")
  holidaysCreated   Holiday[]
  casesAbout        PeopleCase[]           @relation("CaseSubject")
  casesOpened       PeopleCase[]           @relation("CaseCreator")
  casesClosed       PeopleCase[]           @relation("CaseCloser")
  caseItemsOwned    CaseItem[]             @relation("CaseItemOwner")
  caseItemsDone     CaseItem[]             @relation("CaseItemDoneBy")
  documentsAbout    EmployeeDocument[]     @relation("DocumentSubject")
  documentsAdded    EmployeeDocument[]     @relation("DocumentUploader")
  expensesSubmitted Expense[]              @relation("ExpenseSubmitter")
  expensesDecided   Expense[]              @relation("ExpenseDecider")
  expensesPaid      Expense[]              @relation("ExpensePayer")
  expenseEvents     ExpenseEvent[]
  vendorsCreated    Vendor[]               @relation("VendorCreator")
  purchasesRequested PurchaseRequest[]     @relation("PurchaseRequester")
  purchasesDecided  PurchaseRequest[]      @relation("PurchaseDecider")
  purchasesOrdered  PurchaseRequest[]      @relation("PurchaseOrderer")
  purchaseEvents    PurchaseEvent[]
  recordsCreated    FinanceRecord[]        @relation("RecordCreator")
  recordsSettled    FinanceRecord[]        @relation("RecordSettler")
  recordEvents      FinanceRecordEvent[]
  serviceRequested  ServiceRequest[]      @relation("ServiceRequester")
  serviceAssigned   ServiceRequest[]      @relation("ServiceAssignee")
  serviceEvents     ServiceEvent[]
}

model Department {
  id           String                 @id @default(cuid())
  name         String                 @unique
  slug         String                 @unique
  createdAt    DateTime               @default(now())
  memberships  DepartmentMembership[]
  tasks        Task[]
  handoversOut Handover[]             @relation("HandoverFromDept")
  handoversIn  Handover[]             @relation("HandoverToDept")
  contentAudiences ContentAudience[]
  projects     Project[]
  leaveToReview LeaveRequest[]
  expensesToReview Expense[]
  purchasesToReview PurchaseRequest[]
  serviceRequests   ServiceRequest[]
}

model DepartmentMembership {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  type         MembershipType @default(MEMBER)
  isPrimary    Boolean        @default(false)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(NORMAL)
  dueAt         DateTime?
  creatorId     String
  assigneeId    String
  departmentId  String?
  clientToken   String?        @unique
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee      User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  events        TaskEvent[]
  notifications Notification[]
  handovers     Handover[]
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([departmentId])
  @@index([dueAt])
  @@index([leadId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  type      String
  detail    Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  taskId     String?
  handoverId String?
  contentId  String?
  leadId     String?
  projectId  String?
  leaveId    String?
  caseId     String?
  expenseId  String?
  purchaseId String?
  serviceId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  handover   Handover? @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  content    ContentItem? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  leave      LeaveRequest? @relation(fields: [leaveId], references: [id], onDelete: Cascade)
  case       PeopleCase?  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  expense    Expense?     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  purchase   PurchaseRequest? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  service    ServiceRequest? @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum HandoverStatus {
  PENDING
  CLARIFICATION_REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

/// A cross-department handover. Created PENDING; only the named receiver can accept,
/// ask for clarification or reject. CHECK constraints (see migration) enforce that the
/// departments differ and that sender and receiver are different people.
model Handover {
  id                String          @id @default(cuid())
  title             String
  context           String
  deliverable       String
  status            HandoverStatus  @default(PENDING)
  fromDepartmentId  String
  toDepartmentId    String
  senderId          String
  receiverId        String
  dueAt             DateTime?
  linkedTaskId      String?
  /// Source sales lead, when this is a delivery handover from Sales. Nullable; SET NULL keeps the handover if the lead row is ever removed.
  leadId            String?
  clientToken       String?         @unique
  /// When the current acknowledgement request was (re)sent; resets after a clarification answer.
  sentAt            DateTime        @default(now())
  respondedAt       DateTime?
  completedAt       DateTime?
  completionSummary String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  fromDepartment    Department      @relation("HandoverFromDept", fields: [fromDepartmentId], references: [id])
  toDepartment      Department      @relation("HandoverToDept", fields: [toDepartmentId], references: [id])
  sender            User            @relation("HandoverSender", fields: [senderId], references: [id])
  receiver          User            @relation("HandoverReceiver", fields: [receiverId], references: [id])
  linkedTask        Task?           @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  project           Project?
  events            HandoverEvent[]
  notifications     Notification[]

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([status, sentAt])
  @@index([leadId])
}

model HandoverEvent {
  id         String   @id @default(cuid())
  handoverId String
  actorId    String
  type       String
  detail     Json?
  createdAt  DateTime @default(now())
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([handoverId, createdAt])
}

enum ContentType {
  ANNOUNCEMENT
  POLICY
  RESOURCE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AudienceScope {
  ALL
  DEPARTMENTS
}

/// Company Hub item (announcement, policy/SOP or shared resource link). Body is plain text and is
/// always rendered escaped. Never hard-deleted: unpublish/archive keeps history (RULES 7).
/// CHECK constraints in the migration: RESOURCE needs a URL; PUBLISHED needs publisher + date.
model ContentItem {
  id            String            @id @default(cuid())
  type          ContentType
  title         String
  body          String            @default("")
  resourceUrl   String?
  status        ContentStatus     @default(DRAFT)
  audienceScope AudienceScope     @default(ALL)
  /// Increments whenever title, body or link changes; every version is kept in ContentVersion.
  version       Int               @default(1)
  authorId      String
  publisherId   String?
  publishedAt   DateTime?
  clientToken   String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  author        User              @relation("ContentAuthor", fields: [authorId], references: [id])
  publisher     User?             @relation("ContentPublisher", fields: [publisherId], references: [id])
  audiences     ContentAudience[]
  versions      ContentVersion[]
  notifications Notification[]

  @@index([status, type, publishedAt])
  @@index([authorId, status])
}

model ContentAudience {
  id           String      @id @default(cuid())
  contentId    String
  departmentId String
  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id])

  @@unique([contentId, departmentId])
  @@index([departmentId])
}

model ContentVersion {
  id          String      @id @default(cuid())
  contentId   String
  version     Int
  title       String
  body        String
  resourceUrl String?
  editedById  String
  createdAt   DateTime    @default(now())
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  editedBy    User        @relation(fields: [editedById], references: [id])

  @@unique([contentId, version])
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
  /// System entries written by stage/owner actions, never from the manual log form.
  STAGE
  OWNER
}

/// A sales lead. One accountable owner at all times. Visible only to the owner, the creator and the
/// Sales head (see lib/leads.ts). A LOST lead must carry a reason (CHECK in the migration).
model Lead {
  id               String            @id @default(cuid())
  organizationName String
  contactName      String
  contactEmail     String?
  contactPhone     String?
  source           String
  stage            LeadStage         @default(NEW)
  ownerId          String
  createdById      String
  /// Date-only (midnight UTC), like task due dates.
  nextFollowUpAt   DateTime?
  lostReason       String?
  closedAt         DateTime?
  clientToken      String?           @unique
  lastActivityAt   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  owner            User              @relation("LeadOwner", fields: [ownerId], references: [id])
  createdBy        User              @relation("LeadCreator", fields: [createdById], references: [id])
  interactions     LeadInteraction[]
  tasks            Task[]
  handovers        Handover[]
  notifications    Notification[]

  @@index([ownerId, stage])
  @@index([stage, nextFollowUpAt])
  @@index([createdById])
}

model LeadInteraction {
  id         String          @id @default(cuid())
  leadId     String
  actorId    String
  type       InteractionType
  summary    String
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor      User            @relation(fields: [actorId], references: [id])

  @@index([leadId, occurredAt])
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  OPEN
  DONE
}

/// Delivery project owned by one named person in one department. Usually created from an ACCEPTED handover
/// (at most one project per handover: unique handoverId). Never hard-deleted. Dates are date-only (midnight UTC).
model Project {
  id            String          @id @default(cuid())
  name          String
  description   String?
  status        ProjectStatus   @default(ACTIVE)
  departmentId  String
  ownerId       String
  createdById   String
  handoverId    String?         @unique
  dueAt         DateTime?
  completedAt   DateTime?
  clientToken   String?         @unique
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  department    Department      @relation(fields: [departmentId], references: [id])
  owner         User            @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdBy     User            @relation("ProjectCreator", fields: [createdById], references: [id])
  handover      Handover?       @relation(fields: [handoverId], references: [id], onDelete: SetNull)
  members       ProjectMember[]
  milestones    Milestone[]
  tasks         Task[]
  notifications Notification[]

  @@index([departmentId, status])
  @@index([ownerId, status])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation("ProjectMemberUser", fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId])
}

model Milestone {
  id        String          @id @default(cuid())
  projectId String
  title     String
  dueAt     DateTime?
  status    MilestoneStatus @default(OPEN)
  doneAt    DateTime?
  doneById  String?
  createdAt DateTime        @default(now())
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  doneBy    User?           @relation("MilestoneDoneBy", fields: [doneById], references: [id])

  @@index([projectId, status])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Leave request. `leaveType` is a plain string validated against lib/leave.ts (types are not confirmed yet,
/// so changing them must not need a migration). Dates are date-only (midnight UTC), inclusive.
/// `approverDepartmentId` is fixed at submit: any head of that department (never the requester) may decide.
/// CHECKs in the migration: end >= start; decided states carry decidedAt+decidedById; REJECTED carries a note.
model LeaveRequest {
  id                   String       @id @default(cuid())
  requesterId          String
  leaveType            String
  startDate            DateTime
  endDate              DateTime
  reason               String?
  status               LeaveStatus  @default(PENDING)
  approverDepartmentId String
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  clientToken          String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  requester            User         @relation("LeaveRequester", fields: [requesterId], references: [id])
  decidedBy            User?        @relation("LeaveDecider", fields: [decidedById], references: [id])
  approverDepartment   Department   @relation(fields: [approverDepartmentId], references: [id])
  notifications        Notification[]

  @@index([requesterId, status])
  @@index([approverDepartmentId, status])
  @@index([startDate, endDate])
}

/// Company holiday (reference data, one per calendar date). Date-only (midnight UTC). Informational:
/// it does not change leave day counts, because weekend/holiday counting rules are unconfirmed.
model Holiday {
  id          String   @id @default(cuid())
  date        DateTime @unique
  name        String
  createdById String
  createdAt   DateTime @default(now())
  createdBy   User     @relation(fields: [createdById], references: [id])
}

enum CaseType {
  ONBOARDING
  OFFBOARDING
}

enum CaseStatus {
  OPEN
  COMPLETED
  CANCELLED
}

enum CaseItemStatus {
  OPEN
  DONE
}

/// Onboarding or offboarding checklist for one person (Phase 6 slice 3). Only the HR head manages it; item
/// owners see their own items; the subject never sees it. `openKey` is "<subjectId>:<type>" while OPEN and
/// NULL once closed, so its unique index allows only one open case per person and type.
/// CHECKs in the migration: creator <> subject; closed states carry closedAt+closedById; openKey set exactly
/// while OPEN; CANCELLED carries a note.
model PeopleCase {
  id            String         @id @default(cuid())
  type          CaseType
  subjectId     String
  createdById   String
  /// Start date (onboarding) or last working day (offboarding). Date-only (midnight UTC).
  effectiveDate DateTime
  status        CaseStatus     @default(OPEN)
  openKey       String?        @unique
  closeNote     String?
  closedAt      DateTime?
  closedById    String?
  clientToken   String?        @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  subject       User           @relation("CaseSubject", fields: [subjectId], references: [id])
  createdBy     User           @relation("CaseCreator", fields: [createdById], references: [id])
  closedBy      User?          @relation("CaseCloser", fields: [closedById], references: [id])
  items         CaseItem[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([subjectId])
}

model CaseItem {
  id        String         @id @default(cuid())
  caseId    String
  title     String
  ownerId   String
  dueAt     DateTime?
  status    CaseItemStatus @default(OPEN)
  doneAt    DateTime?
  doneById  String?
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  case      PeopleCase     @relation(fields: [caseId], references: [id], onDelete: Cascade)
  owner     User           @relation("CaseItemOwner", fields: [ownerId], references: [id])
  doneBy    User?          @relation("CaseItemDoneBy", fields: [doneById], references: [id])

  @@index([ownerId, status])
  @@index([caseId])
}

enum DocumentKind {
  ID_PROOF
  CONTRACT
  OFFER_LETTER
  CERTIFICATE
  OTHER
}

/// Restricted HR document. Metadata only: the bytes live in private file storage under `storageKey`.
model EmployeeDocument {
  id           String       @id @default(cuid())
  subjectId    String
  kind         DocumentKind
  fileName     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  storageKey   String       @unique
  note         String?
  uploadedById String
  clientToken  String?      @unique
  createdAt    DateTime     @default(now())
  subject      User         @relation("DocumentSubject", fields: [subjectId], references: [id])
  uploadedBy   User         @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([subjectId, createdAt])
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  PAID
}

/// Administrative expense record. Amounts are integer minor units plus a currency code; never floats.
model Expense {
  id                   String        @id @default(cuid())
  submittedById        String
  amountMinor          Int
  currency             String
  category             String
  expenseDate          DateTime
  description          String
  evidenceRef          String
  status               ExpenseStatus @default(SUBMITTED)
  approverDepartmentId String
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  paidById             String?
  paidAt               DateTime?
  paymentRef           String?
  clientToken          String?       @unique
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  submittedBy          User          @relation("ExpenseSubmitter", fields: [submittedById], references: [id])
  decidedBy            User?         @relation("ExpenseDecider", fields: [decidedById], references: [id])
  paidBy               User?         @relation("ExpensePayer", fields: [paidById], references: [id])
  approverDepartment   Department    @relation(fields: [approverDepartmentId], references: [id])
  events               ExpenseEvent[]
  notifications        Notification[]

  @@index([submittedById, status])
  @@index([approverDepartmentId, status])
  @@index([status, createdAt])
}

/// Append-only approval history (ARCHITECTURE: ApprovalEvent).
model ExpenseEvent {
  id         String   @id @default(cuid())
  expenseId  String
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime @default(now())
  expense    Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([expenseId, createdAt])
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

/// Vendor register entry. Never deleted, only deactivated. `nameKey` makes names unique ignoring case and spacing.
model Vendor {
  id          String       @id @default(cuid())
  name        String
  nameKey     String       @unique
  category    String
  contactName String?
  email       String?
  phone       String?
  notes       String?
  status      VendorStatus @default(ACTIVE)
  createdById String
  clientToken String?      @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   User         @relation("VendorCreator", fields: [createdById], references: [id])
  purchases   PurchaseRequest[]
  records     FinanceRecord[]

  @@index([status, name])
}

enum PurchaseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  ORDERED
  RECEIVED
}

/// Internal purchase request. Estimated amount is integer minor units plus a currency; never floats. Not a procurement or accounting system.
model PurchaseRequest {
  id                   String         @id @default(cuid())
  requesterId          String
  title                String
  justification        String
  category             String
  quantity             Int
  estimatedMinor       Int
  currency             String
  neededBy             DateTime?
  status               PurchaseStatus @default(SUBMITTED)
  approverDepartmentId String
  decidedById          String?
  decidedAt            DateTime?
  decisionNote         String?
  vendorId             String?
  orderedById          String?
  orderedAt            DateTime?
  orderRef             String?
  receivedAt           DateTime?
  clientToken          String?        @unique
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  requester            User           @relation("PurchaseRequester", fields: [requesterId], references: [id])
  decidedBy            User?          @relation("PurchaseDecider", fields: [decidedById], references: [id])
  orderedBy            User?          @relation("PurchaseOrderer", fields: [orderedById], references: [id])
  approverDepartment   Department     @relation(fields: [approverDepartmentId], references: [id])
  vendor               Vendor?        @relation(fields: [vendorId], references: [id])
  events               PurchaseEvent[]
  notifications        Notification[]

  @@index([requesterId, status])
  @@index([approverDepartmentId, status])
  @@index([status, createdAt])
  @@index([vendorId])
}

/// Append-only history of a purchase request.
model PurchaseEvent {
  id         String          @id @default(cuid())
  purchaseId String
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime        @default(now())
  purchase   PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  actor      User            @relation(fields: [actorId], references: [id])

  @@index([purchaseId, createdAt])
}

enum ServiceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  DECLINED
  CANCELLED
}

enum ServicePriority {
  LOW
  NORMAL
  HIGH
}

/// Internal service request to Technology or Operations. The category decides the handling department.
model ServiceRequest {
  id             String          @id @default(cuid())
  requesterId    String
  departmentId   String
  title          String
  description    String
  category       String
  priority       ServicePriority @default(NORMAL)
  status         ServiceStatus   @default(OPEN)
  assigneeId     String?
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  decisionNote   String?
  clientToken    String?         @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  requester      User            @relation("ServiceRequester", fields: [requesterId], references: [id])
  assignee       User?           @relation("ServiceAssignee", fields: [assigneeId], references: [id])
  department     Department      @relation(fields: [departmentId], references: [id])
  events         ServiceEvent[]
  notifications  Notification[]

  @@index([requesterId, status])
  @@index([departmentId, status])
  @@index([assigneeId, status])
}

/// Append-only history of a service request.
model ServiceEvent {
  id         String         @id @default(cuid())
  serviceId  String
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime       @default(now())
  service    ServiceRequest @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  actor      User           @relation(fields: [actorId], references: [id])

  @@index([serviceId, createdAt])
}

enum RecordKind {
  QUOTATION
  INVOICE
}

enum RecordStatus {
  OPEN
  PAID
  ACCEPTED
  DECLINED
  VOID
}

/// Register of vendor quotations and invoices (PHASES 7). Integer minor units plus currency. Administrative tracking only: not accounting, not GST.
model FinanceRecord {
  id           String       @id @default(cuid())
  kind         RecordKind
  vendorId     String
  reference    String
  referenceKey String
  amountMinor  Int
  currency     String
  issueDate    DateTime     @db.Date
  dueDate      DateTime?    @db.Date
  status       RecordStatus @default(OPEN)
  note         String?
  paidAt       DateTime?
  paymentRef   String?
  settledAt    DateTime?
  settledById  String?
  createdById  String
  clientToken  String?      @unique
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  vendor       Vendor       @relation(fields: [vendorId], references: [id])
  createdBy    User         @relation("RecordCreator", fields: [createdById], references: [id])
  settledBy    User?        @relation("RecordSettler", fields: [settledById], references: [id])
  events       FinanceRecordEvent[]

  @@unique([vendorId, kind, referenceKey])
  @@index([kind, status, dueDate])
  @@index([vendorId])
}

model FinanceRecordEvent {
  id         String        @id @default(cuid())
  recordId   String
  actorId    String
  action     String
  fromStatus String?
  toStatus   String
  comment    String?
  createdAt  DateTime      @default(now())
  record     FinanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actor      User          @relation(fields: [actorId], references: [id])

  @@index([recordId, createdAt])
}
