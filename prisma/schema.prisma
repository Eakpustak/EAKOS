generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

enum SystemRole {
  ADMIN
  MEMBER
}

enum MembershipType {
  HEAD
  MEMBER
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  displayName       String
  passwordHash      String?
  status            UserStatus             @default(ACTIVE)
  systemRole        SystemRole             @default(MEMBER)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  memberships       DepartmentMembership[]
  tasksCreated      Task[]                 @relation("TaskCreator")
  tasksAssigned     Task[]                 @relation("TaskAssignee")
  taskComments      TaskComment[]
  taskEvents        TaskEvent[]
  notifications     Notification[]
  handoversSent     Handover[]             @relation("HandoverSender")
  handoversReceived Handover[]             @relation("HandoverReceiver")
  handoverEvents    HandoverEvent[]
  contentAuthored   ContentItem[]          @relation("ContentAuthor")
  contentPublished  ContentItem[]          @relation("ContentPublisher")
  contentVersions   ContentVersion[]
  leadsOwned        Lead[]                 @relation("LeadOwner")
  leadsCreated      Lead[]                 @relation("LeadCreator")
  leadInteractions  LeadInteraction[]
}

model Department {
  id           String                 @id @default(cuid())
  name         String                 @unique
  slug         String                 @unique
  createdAt    DateTime               @default(now())
  memberships  DepartmentMembership[]
  tasks        Task[]
  handoversOut Handover[]             @relation("HandoverFromDept")
  handoversIn  Handover[]             @relation("HandoverToDept")
  contentAudiences ContentAudience[]
}

model DepartmentMembership {
  id           String         @id @default(cuid())
  userId       String
  departmentId String
  type         MembershipType @default(MEMBER)
  isPrimary    Boolean        @default(false)
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department     @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@unique([userId, departmentId])
  @@index([departmentId])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([resourceType, resourceId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Task {
  id            String         @id @default(cuid())
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(NORMAL)
  dueAt         DateTime?
  creatorId     String
  assigneeId    String
  departmentId  String?
  clientToken   String?        @unique
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee      User           @relation("TaskAssignee", fields: [assigneeId], references: [id])
  department    Department?    @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  comments      TaskComment[]
  events        TaskEvent[]
  notifications Notification[]
  handovers     Handover[]
  leadId        String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([assigneeId, status])
  @@index([creatorId])
  @@index([departmentId])
  @@index([dueAt])
  @@index([leadId])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])

  @@index([taskId, createdAt])
}

model TaskEvent {
  id        String   @id @default(cuid())
  taskId    String
  actorId   String
  type      String
  detail    Json?
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor     User     @relation(fields: [actorId], references: [id])

  @@index([taskId, createdAt])
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  type       String
  title      String
  taskId     String?
  handoverId String?
  contentId  String?
  leadId     String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task       Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  handover   Handover? @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  content    ContentItem? @relation(fields: [contentId], references: [id], onDelete: Cascade)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

enum HandoverStatus {
  PENDING
  CLARIFICATION_REQUESTED
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

/// A cross-department handover. Created PENDING; only the named receiver can accept,
/// ask for clarification or reject. CHECK constraints (see migration) enforce that the
/// departments differ and that sender and receiver are different people.
model Handover {
  id                String          @id @default(cuid())
  title             String
  context           String
  deliverable       String
  status            HandoverStatus  @default(PENDING)
  fromDepartmentId  String
  toDepartmentId    String
  senderId          String
  receiverId        String
  dueAt             DateTime?
  linkedTaskId      String?
  /// Source sales lead, when this is a delivery handover from Sales. Nullable; SET NULL keeps the handover if the lead row is ever removed.
  leadId            String?
  clientToken       String?         @unique
  /// When the current acknowledgement request was (re)sent; resets after a clarification answer.
  sentAt            DateTime        @default(now())
  respondedAt       DateTime?
  completedAt       DateTime?
  completionSummary String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  fromDepartment    Department      @relation("HandoverFromDept", fields: [fromDepartmentId], references: [id])
  toDepartment      Department      @relation("HandoverToDept", fields: [toDepartmentId], references: [id])
  sender            User            @relation("HandoverSender", fields: [senderId], references: [id])
  receiver          User            @relation("HandoverReceiver", fields: [receiverId], references: [id])
  linkedTask        Task?           @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)
  lead              Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  events            HandoverEvent[]
  notifications     Notification[]

  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([fromDepartmentId])
  @@index([toDepartmentId])
  @@index([status, sentAt])
  @@index([leadId])
}

model HandoverEvent {
  id         String   @id @default(cuid())
  handoverId String
  actorId    String
  type       String
  detail     Json?
  createdAt  DateTime @default(now())
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([handoverId, createdAt])
}

enum ContentType {
  ANNOUNCEMENT
  POLICY
  RESOURCE
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AudienceScope {
  ALL
  DEPARTMENTS
}

/// Company Hub item (announcement, policy/SOP or shared resource link). Body is plain text and is
/// always rendered escaped. Never hard-deleted: unpublish/archive keeps history (RULES 7).
/// CHECK constraints in the migration: RESOURCE needs a URL; PUBLISHED needs publisher + date.
model ContentItem {
  id            String            @id @default(cuid())
  type          ContentType
  title         String
  body          String            @default("")
  resourceUrl   String?
  status        ContentStatus     @default(DRAFT)
  audienceScope AudienceScope     @default(ALL)
  /// Increments whenever title, body or link changes; every version is kept in ContentVersion.
  version       Int               @default(1)
  authorId      String
  publisherId   String?
  publishedAt   DateTime?
  clientToken   String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  author        User              @relation("ContentAuthor", fields: [authorId], references: [id])
  publisher     User?             @relation("ContentPublisher", fields: [publisherId], references: [id])
  audiences     ContentAudience[]
  versions      ContentVersion[]
  notifications Notification[]

  @@index([status, type, publishedAt])
  @@index([authorId, status])
}

model ContentAudience {
  id           String      @id @default(cuid())
  contentId    String
  departmentId String
  content      ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  department   Department  @relation(fields: [departmentId], references: [id])

  @@unique([contentId, departmentId])
  @@index([departmentId])
}

model ContentVersion {
  id          String      @id @default(cuid())
  contentId   String
  version     Int
  title       String
  body        String
  resourceUrl String?
  editedById  String
  createdAt   DateTime    @default(now())
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)
  editedBy    User        @relation(fields: [editedById], references: [id])

  @@unique([contentId, version])
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
  /// System entries written by stage/owner actions, never from the manual log form.
  STAGE
  OWNER
}

/// A sales lead. One accountable owner at all times. Visible only to the owner, the creator and the
/// Sales head (see lib/leads.ts). A LOST lead must carry a reason (CHECK in the migration).
model Lead {
  id               String            @id @default(cuid())
  organizationName String
  contactName      String
  contactEmail     String?
  contactPhone     String?
  source           String
  stage            LeadStage         @default(NEW)
  ownerId          String
  createdById      String
  /// Date-only (midnight UTC), like task due dates.
  nextFollowUpAt   DateTime?
  lostReason       String?
  closedAt         DateTime?
  clientToken      String?           @unique
  lastActivityAt   DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  owner            User              @relation("LeadOwner", fields: [ownerId], references: [id])
  createdBy        User              @relation("LeadCreator", fields: [createdById], references: [id])
  interactions     LeadInteraction[]
  tasks            Task[]
  handovers        Handover[]
  notifications    Notification[]

  @@index([ownerId, stage])
  @@index([stage, nextFollowUpAt])
  @@index([createdById])
}

model LeadInteraction {
  id         String          @id @default(cuid())
  leadId     String
  actorId    String
  type       InteractionType
  summary    String
  occurredAt DateTime        @default(now())
  createdAt  DateTime        @default(now())
  lead       Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor      User            @relation(fields: [actorId], references: [id])

  @@index([leadId, occurredAt])
}
